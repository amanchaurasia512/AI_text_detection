
# API provider is intentionally unconfigured. Set these only after selecting one.
AUDIT_API_ENDPOINT=
AUDIT_API_KEY=
# The adapter sends {"text": "..."}; change field with AUDIT_API_TEXT_FIELD.
AUDIT_API_TEXT_FIELD=text
# Configure JSON response paths from the selected provider's documentation.
AUDIT_RESPONSE_SCORE_PATH=
AUDIT_RESPONSE_CLASSIFICATION_PATH=
AUDIT_RESPONSE_CONFIDENCE_PATH=
AUDIT_RESPONSE_UNCERTAINTY_PATH=
# Authentication is only attached if both this and AUDIT_API_KEY are configured.
AUDIT_API_AUTH_HEADER=Authorization
AUDIT_API_AUTH_PREFIX=Bearer
AUDIT_API_TIMEOUT=30
AUDIT_API_RETRIES=2
AUDIT_MIN_PARAGRAPH_CHARS=80
